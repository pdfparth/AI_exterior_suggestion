# Copy to .env and fill in your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional. Only set these if the defaults are unavailable on your key —
# the app already falls back through a list of alternatives automatically.
# GEMINI_VISION_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
